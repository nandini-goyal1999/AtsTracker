              "name": "Stage",
              "type": "string",
              "value": "={{ Number($json.output[0].content[0].text.score) >= 70 ? 'Assessment' : (Number($json.output[0].content[0].text.score) >= 40 ? 'Review' : 'Rejected') }}"
            },
            {
              "id": "a8",
              "name": "Notes",
              "type": "string",
              "value": "={{ ($('New Candidate Row').item.json.Notes ? $('New Candidate Row').item.json.Notes + '\\n' : '') + 'Auto-routed to ' + (Number($json.output[0].content[0].text.score) >= 70 ? 'Assessment' : (Number($json.output[0].content[0].text.score) >= 40 ? 'Review' : 'Rejected')) + ' on ' + $now.toFormat('yyyy-MM-dd') }}"
