        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a recruiter screening resumes. Score the resume against the job description. Return only JSON in exactly this shape: {\"score\": <integer 0-100>, \"strengths\": [3 short items], \"gaps\": [2 short items], \"recommendation\": \"Advance\" | \"Hold\" | \"Reject\"}. No other text."
            },
            {
              "content": "=Job description:\nData Science Analyst. Responsibilities: clean, analyze and visualize data to answer business questions; write SQL queries and Python scripts; build dashboards in Power BI or Tableau; build and evaluate simple machine learning models; present findings clearly to non-technical stakeholders. Requirements: bachelor's degree in a quantitative field; strong SQL and Python (pandas); experience with Power BI or Tableau; understanding of statistics and machine learning basics; strong communication and attention to detail. Assets: cloud tools, automation, AI tools.\n\nResume:\n{{ $json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_object"
            }
          }
        }
      },
